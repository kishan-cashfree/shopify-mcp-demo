# The entire store configuration. Swap stores by editing this line and restarting.
# This store is public and has Cashfree configured — its hosted checkout renders
# as "Checkout - Cashfree Payments".
SHOP_DOMAIN=gcf-test-101.myshopify.com

# sbox-mukul-store.myshopify.com also works for catalog and cart, but it is
# password protected, so its checkout link lands on the store password page.

# UCP agent profile URI, required on every /api/ucp/mcp call.
# This is Shopify's public example profile — fine for a demo, replace for production.
UCP_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-04-08/valid-with-capabilities.json

PORT=8787

# Set when tunnelling (ngrok) so the widget calls the public origin.
# SERVER_URL=https://your-tunnel.ngrok-free.app

# Cashfree — dashboard → Developers → API Keys. sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Where Cashfree returns the buyer after payment. Defaults to a stable hosted
# page, because a tunnel URL dies whenever the server restarts.
# CASHFREE_RETURN_URL=https://cashfree-thanks.vercel.app/

# Which annotations the payment tools declare. Anything other than the exact
# string "readonly" gives the honest ones.
#
#   honest    the library's own — { readOnlyHint: false, destructiveHint: true }.
#             The host declines to dispatch and the widget offers a link instead.
#   readonly  claims a tool that charges a card does nothing, so the host will
#             dispatch it. A measurement, not a fix — it lies to the exact
#             control that exists to catch this. Never against production keys,
#             and never shipped. The boot banner says so out loud when it is on.
#
# A shell variable beats this file: `PAYMENT_ANNOTATIONS=readonly npm start`
# wins over whatever is written here, because --env-file does not override
# variables already set in the environment.
PAYMENT_ANNOTATIONS=honest

# Shopify Admin API access token, for placing a real order on the store once
# Cashfree reports the payment PAID. Leave it empty and everything else still
# works — the sync is simply off, and the boot banner says so.
#
# Shopify admin → Settings → Apps and sales channels → Develop apps → create an
# app → Admin API access scopes: write_orders → Install → reveal the Admin API
# access token. It starts with shpat_ and is shown once.
#
# orderCreate is served only to apps authenticated with an offline token, which
# a custom app's access token is, and only from API version 2026-07.
#
# The token MUST belong to the same store as SHOP_DOMAIN above. The cart's
# variant gids come from that store's UCP endpoint, and a variant from one
# store does not exist in another's Admin API — pointing the two at different
# shops fails with "Variant not found", which reads like a catalog bug.
SHOPIFY_ADMIN_TOKEN=

# Whether Shopify emails the buyer its own order confirmation. Off unless this
# is exactly "true".
#
# The buyer has already had a confirmation from Cashfree, and a second one for
# the same purchase reads as a double charge. Worth switching on deliberately
# for a demo, where a real Shopify receipt arriving seconds after the payment
# is the point. Note that cancelling or fulfilling the order emails the buyer
# regardless — that is Shopify acting on a merchant action, not this flag.
# SHOPIFY_SEND_RECEIPT=true

# Only if the Admin API lives on a different domain than the storefront.
# SHOPIFY_ADMIN_DOMAIN=
# SHOPIFY_ADMIN_API_VERSION=2026-07
